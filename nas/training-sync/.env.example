# Nach /volume1/Grundlagen/training/sync/.env kopieren und anpassen (keine Secrets – der Deploy-Key liegt als Datei unter keys/).
ARCHIV_REPO=git@github.com:MarqEwi/training-archiv.git
ARCHIV_BRANCH=main
INTERVAL=600
# UID/GID von MarcEwers auf der NAS (ssh MarcEwers@STEVENAS id)
PUID=1000
PGID=1000
# Zeitlimit in Sekunden für git clone/pull, damit eine hängende Verbindung die Schleife nicht blockiert
GIT_TIMEOUT=300
# Statusmeldung nach jedem Durchlauf an den MQTT-Broker der NAS. Leer lassen schaltet sie ab.
# nas-host löst über extra_hosts auf das Docker-Gateway auf – die LAN-IP funktioniert aus dem
# Bridge-Netz wegen des kaputten Hairpin-NAT nicht.
MQTT_HOST=nas-host
MQTT_PORT=1883
MQTT_TOPIC=training/sync/status
